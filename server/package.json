{
  "name": "@survev/server",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "typecheck": "tsc",
    "start:api": "bun src/api/index.ts",
    "start:game": "bun src/gameServer.ts",
    "dev": "cd .. && bun run dev",
    "dev:api": "cd .. && bun run dev:api",
    "dev:game": "cd .. && bun run dev:game",
    "db:generate": "drizzle-kit generate --config=src/api/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=src/api/drizzle.config.ts",
    "db:seed": "tsx src/api/db/seed.ts",
    "db:studio": "drizzle-kit studio --config=src/api/drizzle.config.ts",
    "db:wipe": "tsx src/api/db/wipe.ts",
    "stressTest": "tsx src/stressTest.ts",
    "lint": "cd .. && bun run lint"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "@oslojs/crypto": "^1.0.1",
    "arctic": "^3.7.0",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0",
    "mongodb": "^7.6.0",
    "mysql2": "^3.24.3",
    "nanotimer": "^0.3.15",
    "obscenity": "^0.4.6",
    "pg": "^8.22.0",
    "redis": "^5.12.1",
    "slugify": "^1.6.9",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/nanotimer": "^0.3.2",
    "@types/node": "~22.12.0",
    "@types/pg": "^8.20.3",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "rolldown": "^1.2.2",
    "tsx": "^4.23.5",
    "unique-username-generator": "^1.5.1"
  }
}
