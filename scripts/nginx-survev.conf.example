# Example nginx config for a single-machine Survev deployment.
# Copy to /etc/nginx/sites-available/survev.conf and adjust paths/domain.
#
# Public ports: 80 and/or 443 only. Game child processes (9000+) and the game
# master (8001) stay on localhost; nginx tunnels WebSockets via /g/<port>/ and /ptc.
#
# See nginx.conf at the repo root for the production-ready copy used on a Pelican node.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name your.domain.example;

    root /opt/survev/client/dist;
    index index.html;

    client_max_body_size 4m;

    location ~* \.(js|css|jpg|jpeg|png|gif|ico|svg|webp|woff2?)$ {
        expires 1y;
        etag off;
        if_modified_since off;
        add_header Cache-Control "public, no-transform";
        try_files $uri =404;
    }

    location ~* \.(html)$ {
        etag on;
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /stats/ {
        try_files $uri $uri/ /stats/index.html;
    }

    location /api {
        proxy_http_version 1.1;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $http_host;
        proxy_pass http://127.0.0.1:8000;
    }

    location /private {
        proxy_http_version 1.1;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $http_host;
        proxy_pass http://127.0.0.1:8000;
    }

    location /team_v2 {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $http_host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_pass http://127.0.0.1:8000;
        proxy_redirect off;
    }

    location /ptc {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $http_host;
        proxy_pass http://127.0.0.1:8001;
        proxy_redirect off;
    }

    # Player session find_game (ticket from master → matchmaking on this game node).
    location /session/ {
        proxy_http_version 1.1;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $http_host;
        proxy_read_timeout 15s;
        proxy_pass http://127.0.0.1:8001;
        proxy_redirect off;
    }

    location ~ ^/g/(?<game_port>9[0-9]+)(?<game_path>/.*)$ {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $http_host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_pass http://127.0.0.1:$game_port$game_path$is_args$args;
        proxy_redirect off;
    }
}

# HTTPS example (certbot / your own certs):
# server {
#     listen 443 ssl http2;
#     listen [::]:443 ssl http2;
#     server_name your.domain.example;
#     ssl_certificate     /etc/letsencrypt/live/your.domain.example/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/your.domain.example/privkey.pem;
#     # ...same location blocks as above...
# }
